{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryRequest",
  "type": "object",
  "required": ["bedId", "airTemp", "soilTemp", "light", "moisture", "humidity"],
  "properties": {
    "bedId":     { "type": "string" },
    "airTemp":   { "type": "number" },
    "soilTemp":  { "type": "number" },
    "light":     { "type": "number", "minimum": 0, "maximum": 1 },
    "moisture":  { "type": "number", "minimum": 0, "maximum": 1 },
    "humidity":  { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
